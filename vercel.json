{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run typecheck:libs && pnpm --filter @workspace/maya-perfume-shop run build",
  "outputDirectory": "artifacts/maya-perfume-shop/dist/public",
  "rewrites": [
    { "source": "/welcome", "destination": "/index.html" },
    { "source": "/collection", "destination": "/index.html" },
    { "source": "/product/:id", "destination": "/index.html" },
    { "source": "/wishlist", "destination": "/index.html" },
    { "source": "/bag", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/raw-material", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/shipping", "destination": "/index.html" },
    { "source": "/returns", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ]
}
