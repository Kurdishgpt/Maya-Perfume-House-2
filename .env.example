# Copy this template to .env only for local development outside Replit.
# Replit uses Tools > Secrets; Netlify needs variables in its site settings.
# Never commit a populated .env file.
# Maya Collection Supabase setup
# The anon key is intended for the browser and is protected by database RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Server-only values. Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
ADMIN_PANEL_PASSWORD=choose-a-strong-admin-passphrase
SESSION_SECRET=replace-with-a-long-random-session-secret

# Optional: only for copying legacy Replit data. Never use this for Supabase.
DATABASE_URL=postgresql://user:password@legacy-database-host:5432/database

# Optional server-only key for Gemini-powered fragrance tools.
GEMINI_API_KEY=your-gemini-api-key

# Optional schema-migration connection string; use the Supabase SQL Editor instead.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
