# Maya Collection Supabase setup
# The anon key is intended for the browser and is protected by database RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Server-only values. Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
